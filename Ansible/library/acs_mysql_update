#!/usr/bin/env python3

import json
import shlex
import subprocess
import sys


def main():
    args_file = sys.argv[1]
    with open(args_file) as f:
        line = f.read()

    values = {}
    for token in shlex.split(line):
        if "=" in token:
            key, _, value = token.partition("=")
            values[key] = value

    db_host = values.get("DBHOST", "")
    db_user = values.get("DBUSER", "")
    db_pass = values.get("DBPASS", "")
    mysql_statement = values.get("MYSQL_STATEMENT", "")

    with open("/tmp/args", "w") as f:
        f.write(line)
    with open("/tmp/mysql", "w") as f:
        f.write(mysql_statement)

    cmd = ["mysql", "-h", db_host, "-u", db_user, "-p" + db_pass, "-e", mysql_statement]
    with open("/tmp/theargs", "w") as f:
        f.write(" ".join(shlex.quote(c) for c in cmd))

    result = subprocess.run(cmd, capture_output=True, text=True)

    if result.returncode != 0:
        print(json.dumps({
            "failed": True,
            "msg": "mysql command failed (rc=%d): %s" % (result.returncode, (result.stderr or result.stdout).strip()),
        }))
        sys.exit(1)

    print(json.dumps({"ansible_facts": {"reponse": "Attempted"}}))


if __name__ == "__main__":
    main()
